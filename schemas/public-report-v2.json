{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dany-fedorov/application-exception/schemas/public-report-v2.json",
  "title": "Application Exception public report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "reference", "code", "message"],
  "properties": {
    "v": { "const": "appex/public/v2" },
    "reference": { "type": "string", "minLength": 1, "maxLength": 128 },
    "code": { "type": "string", "minLength": 1, "maxLength": 128 },
    "message": { "type": "string", "maxLength": 4096 },
    "details": { "$ref": "#/definitions/diagnosticValue" },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "messageOmitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "detailsOmitted": { "const": true }
      }
    }
  },
  "definitions": {
    "diagnosticValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/diagnosticValue" }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/diagnosticValue"
          }
        }
      ]
    }
  }
}

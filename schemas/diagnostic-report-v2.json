{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/dany-fedorov/application-exception/schemas/diagnostic-report-v2.json",
  "title": "Application Exception diagnostic report v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "reference", "name", "message"],
  "properties": {
    "v": { "const": "appex/diagnostic/v2" },
    "reference": { "type": "string", "minLength": 1, "maxLength": 128 },
    "kind": { "type": "string", "maxLength": 128 },
    "name": { "type": "string", "maxLength": 128 },
    "message": { "type": "string", "maxLength": 65536 },
    "timestamp": { "type": "string", "maxLength": 128 },
    "code": {
      "oneOf": [{ "type": "string", "maxLength": 128 }, { "type": "number" }]
    },
    "status": {
      "oneOf": [{ "type": "string", "maxLength": 128 }, { "type": "number" }]
    },
    "stack": { "$ref": "#/definitions/diagnosticValue" },
    "details": { "$ref": "#/definitions/diagnosticValue" },
    "context": { "$ref": "#/definitions/diagnosticValue" },
    "cause": { "$ref": "#/definitions/diagnosticValue" },
    "thrown": { "$ref": "#/definitions/diagnosticValue" },
    "messageRenderingError": {
      "$ref": "#/definitions/diagnosticValue"
    },
    "truncation": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "messageOmitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "nameOmitted": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "diagnosticsOmitted": { "const": true }
      }
    }
  },
  "definitions": {
    "diagnosticValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        {
          "type": "array",
          "items": { "$ref": "#/definitions/diagnosticValue" }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/diagnosticValue"
          }
        }
      ]
    }
  }
}
